#include <bits/stdc++.h>
using namespace std;
class Solution {
public:
    int countWindows(vector<int>& arr, int k, int target) {
        int sum=0;
        int n=arr.size();
        for(int i=0;i<k;i++){
            sum+=arr[i];
        }
        int count=0;
        if(sum>=target){
                count++;
            }
        for(int i=k;i<n;i++){
            sum=sum-arr[i-k]+arr[i];
            if(sum>=target){
                count++;
            }
        }
        return count;
    }
};
int main() {
    Solution s;
    vector<int> arr = {2, 1, 5, 1, 3, 2};
    int k = 3;
    int target = 6;
    cout << s.countWindows(arr, k, target);
    return 0;
}
