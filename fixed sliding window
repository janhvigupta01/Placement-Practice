#include <bits/stdc++.h>
using namespace std;
class Solution {
public:
    int numOfSubarrays(vector<int>& arr, int k, int threshold) {
        int n=arr.size();
        int sum=0;
        for(int i=0;i<k;i++){
            sum+=arr[i];
        }
        int maximum=sum;
        int c=0;
        if(sum >= threshold * k)
    c++;
        for(int i=k;i<n;i++){
            sum=sum-arr[i-k]+arr[i];
            if(sum>=threshold*k){
                c++;
            }
        }
return c;
    }
};
int main() {
    vector<int> arr = {2, 2, 2, 2, 5, 5, 5, 8};
    int k = 3;
    int threshold = 4;
    Solution obj;
    cout << obj.numOfSubarrays(arr, k, threshold);
    return 0;
}



#include <bits/stdc++.h>
using namespace std;
class Solution {
public:
    vector<int> firstNegative(vector<int>& arr, int k) {
        queue<int>q;
        int n=arr.size();
        for(int i=0;i<k;i++){
            if(arr[i]<0){
                q.push(i);
            }
        }
        vector<int>ans;
        if(q.empty()){
            ans.push_back(0);
        }else{
            ans.push_back(arr[q.front()]);
        }
    for(int i=k;i<n;i++){
        if(!q.empty() && q.front()<i-k+1){
            q.pop();
        }
        if(arr[i]<0){
         q.push(i);
        }
        if(q.empty()){
            ans.push_back(0);
        }else{
            ans.push_back(arr[q.front()]);
        }
    }
    return ans;
    }
};
int main() {
    vector<int> arr = {12, -1, -7, 8, -15, 30, 16, 28};
    int k = 3;
    Solution obj;
    vector<int> ans = obj.firstNegative(arr, k);
    for(int x : ans) {
        cout << x << " ";
    }
    return 0;
}

